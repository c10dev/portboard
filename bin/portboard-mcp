#!/bin/sh
# Start the portboard stdio MCP server. Entry point for remote clients over SSH
# (non-interactive SSH doesn't load nvm, so find node here instead of in every client config).
set -e
DIR=$(cd "$(dirname "$0")/.." && pwd)
NODE=$(command -v node 2>/dev/null || true)
if [ -z "$NODE" ]; then
  NODE=$(ls -d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -V | tail -1)
fi
if [ -z "$NODE" ]; then
  echo "portboard-mcp: node not found" >&2
  exit 1
fi
exec "$NODE" "$DIR/src/mcp.ts"
