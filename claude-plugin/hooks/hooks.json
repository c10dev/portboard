{
  "description": "Portboard: port nudge before Bash (adds context, never blocks), the worktree's reserved port as PORT at session start and on cwd change, and session-end cleanup",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/port-nudge.ts\"", "timeout": 5 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/session-port.ts\"", "timeout": 5 }]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/session-port.ts\"", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.ts\"" }]
      }
    ]
  }
}
