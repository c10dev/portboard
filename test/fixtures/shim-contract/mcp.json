  {
   "name": "connection refused after the ping: one more try after 1 s, then the in-process server, which keeps the session",
   "daemon": {
    "ping": {
     "status": 200,
     "body": "{\"ok\":true,\"version\":\"0.0.0\"}"
    },
    "closeAfterPing": true
   },
   "stdin": [
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"nope\"}",
    {
     "waitLines": 1
    },
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"nope\"}"
   ],
   "expect": {
    "stdout": [
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"method not found: nope\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32601,\"message\":\"method not found: nope\"}}"
    ],
    "exit": 0,
    "pings": 1,
    "posts": 0
   }
