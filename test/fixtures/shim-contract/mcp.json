{
 "about": "Contract cases for the plugin's MCP process: claude-plugin/bin/mcp.mjs (Node) and shim/ (Go) must both give each expected result. Read by test/shim-contract.test.ts and shim/main_test.go. A line of 'stdin' is sent as is; {waitLines: n} waits until n lines were printed. stdout lines are compared as a set (concurrent requests answer in any order). 'node' and 'go' inside 'expect' override a value for one side. Daemon replies: reply 'echo' answers {result: {echo: method}} with the request's id; whenMethod picks the entry by the request's method; hangup closes the connection after the request was read; closeAfterPing closes the listener when the ping is answered; refuse means nothing listens. String ids and integer ids only (a Go re-encode escapes U+2028 and U+2029, JSON.stringify does not).",
 "cases": [
  {
   "name": "relay: initialize, tools/list and tools/call, string and integer ids",
   "daemon": {
    "ping": {
     "status": 200,
     "body": "{\"ok\":true,\"version\":\"0.0.0\"}"
    },
    "posts": [
     {
      "status": 200,
      "reply": "echo"
     }
    ]
   },
   "stdin": [
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"tools/call\"}"
   ],
   "expect": {
    "stdout": [
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"echo\":\"initialize\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"echo\":\"tools/list\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"result\":{\"echo\":\"tools/call\"}}"
    ],
    "exit": 0,
    "pings": 1,
    "posts": 3,
    "bodies": [
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}",
     "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}",
     "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"tools/call\"}"
    ],
    "session": null,
    "pid": null
   }
  },
  {
   "name": "a notification is sent and a 204 prints nothing",
   "daemon": {
    "ping": {
     "status": 200,
     "body": "{\"ok\":true,\"version\":\"0.0.0\"}"
    },
    "posts": [
     {
      "status": 204
     }
    ]
   },
   "stdin": [
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
   ],
   "expect": {
    "stdout": [],
    "exit": 0,
    "pings": 1,
    "posts": 1
   }
  },
  {
   "name": "a message that is not an object is a notification: sent, and a 204 prints nothing",
   "daemon": {
    "ping": {
     "status": 200,
     "body": "{\"ok\":true,\"version\":\"0.0.0\"}"
    },
    "posts": [
     {
      "status": 204
     }
    ]
   },
   "stdin": [
    "123",
    "[]",
    "null"
   ],
   "expect": {
    "stdout": [],
    "exit": 0,
    "pings": 1,
    "posts": 3
   }
  },
  {
   "name": "empty lines are skipped, not sent",
