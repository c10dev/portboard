    },
    "posts": [
     {
      "status": 200,
      "reply": "echo"
     }
    ]
   },
   "stdin": [
    "",
    "   ",
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}"
   ],
   "expect": {
    "stdout": [
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"echo\":\"ping\"}}"
    ],
    "exit": 0,
    "pings": 1,
    "posts": 1
   }
  },
