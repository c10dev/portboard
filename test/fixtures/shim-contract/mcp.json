  {
   "name": "403, 404, 405, 500 and 502 in mid-session: -32603 with the status, and no retry",
   "daemon": {
    "ping": {
     "status": 200,
     "body": "{\"ok\":true,\"version\":\"0.0.0\"}"
    },
    "posts": [
     {
      "whenMethod": "m403",
      "status": 403,
      "body": "{\"error\":\"owner only\"}"
     },
     {
      "whenMethod": "m404",
      "status": 404,
      "body": "{\"error\":\"not found\"}"
     },
     {
      "whenMethod": "m405",
      "status": 405,
      "body": ""
     },
     {
      "whenMethod": "m500",
      "status": 500,
      "body": "oops"
     },
     {
      "whenMethod": "m502",
      "status": 502,
      "body": "<html>bad gateway</html>"
     }
    ]
   },
   "stdin": [
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"m403\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"m404\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"m405\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"m500\"}",
    "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"m502\"}"
   ],
   "expect": {
    "stdout": [
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32603,\"message\":\"Portboard dashboard request failed: 403\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32603,\"message\":\"Portboard dashboard request failed: 404\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32603,\"message\":\"Portboard dashboard request failed: 405\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32603,\"message\":\"Portboard dashboard request failed: 500\"}}",
     "{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32603,\"message\":\"Portboard dashboard request failed: 502\"}}"
    ],
    "exit": 0,
    "pings": 1,
    "posts": 5
   }
